# SportMind Fan Token Agentic Wallet — Environment Configuration
# Copy this file to .env and fill in your values.
# The kit runs on mock data without any keys set.

# ── LLM PROVIDER ─────────────────────────────────────────────────────────────
# Options: claude | openai
LLM_PROVIDER=claude

# Anthropic Claude (recommended)
ANTHROPIC_API_KEY=

# OpenAI / Groq / Together / Ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=claude-sonnet-4-5

# ── WALLET ────────────────────────────────────────────────────────────────────
# NEVER commit a real private key. Use a dev wallet on Spicy testnet first.
WALLET_PRIVATE_KEY=
CHILIZ_NETWORK=testnet

# ── GUARDRAILS ────────────────────────────────────────────────────────────────
# Start with confirm mode. Only switch to auto when fully tested.
EXECUTION_MODE=confirm
DAILY_SPEND_CAP_CHZ=100
APPROVAL_THRESHOLD_CHZ=20
MACRO_OVERRIDE_BLOCKS=true
